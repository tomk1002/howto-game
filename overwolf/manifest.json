{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "ComboGG",
    "version": "0.1.0.0",
    "minimum-overwolf-version": "0.200.0.0",
    "author": "ComboGG Team",
    "icon": "icon.png",
    "icon_gray": "icon_gray.png",
    "description": "LoL combo practice"
  },
  "permissions": [
    "Extensions",
    "Hotkeys",
    "GameInfo",
    "Media",
    "FileSystem",
    "Streaming"
  ],
  "data": {
    "start_window": "background",
    "windows": {
      "background": {
        "file": "windows/background.html",
        "transparent": false,
        "resizable": false,
        "show_in_taskbar": false,
        "is_background_page": true
      },
      "overlay": {
        "file": "windows/overlay.html",
        "transparent": true,
        "resizable": false,
        "show_in_taskbar": false,
        "size": { "width": 1920, "height": 1080 },
        "keep_window_location": false
      }
    },
    "game_events": [5426],
    "hotkeys": {
      "toggle_overlay": {
        "title": "Toggle overlay",
        "action-type": "custom",
        "default": "F10"
      },
      "start_practice": {
        "title": "Start stop practice",
        "action-type": "custom",
        "default": "F9"
      }
    },
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [5426]
    },
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": { "game_ids": [5426] },
        "start_minimized": false
      }
    ]
  }
}
